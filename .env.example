# Optix Monorepo Development Environment Configuration Template
# Copy this file to .env for local development

# Node Environment
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database Configuration (Local PostgreSQL 16)
DATABASE_URL=postgresql://optix_admin:optix_pass_local@localhost:5432/optix_dev?schema=public

# Redis Configuration (Local Redis 7.2)
REDIS_URL=redis://localhost:6379

# Firebase Admin SDK Credentials
FIREBASE_PROJECT_ID=optix-pos-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@optix-pos-dev.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Security & Secret Keys
JWT_SECRET=super_secret_jwt_key_optix_local_dev_32bytes
IDEMPOTENCY_TTL_SECONDS=86400
