# Multi-Stage Production & Staging Dockerfile for Optix Backend API Core
# Stage 1: Build & Compilation
FROM node:20-alpine AS builder

WORKDIR /app

# Copy monorepo configuration files
COPY package.json package-lock.json ./
COPY packages/shared-types/package.json ./packages/shared-types/
COPY apps/backend/package.json ./apps/backend/

# Install all dependencies including devDependencies
RUN npm ci

# Copy source files
COPY packages/shared-types ./packages/shared-types
COPY apps/backend ./apps/backend

# Build shared types & backend TypeScript
RUN npm --workspace=packages/shared-types run build
RUN npm --workspace=apps/backend run build

# Generate Prisma Client
RUN cd apps/backend && npx prisma generate

# Stage 2: Production Runtime Image
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOST=0.0.0.0

# Create unprivileged application user
RUN addgroup -g 1001 -S optixgroup && \
    adduser -u 1001 -S optixuser -G optixgroup

# Copy built dist files & package definitions from Stage 1 (builder)
COPY package.json package-lock.json ./
COPY packages/shared-types/package.json ./packages/shared-types/
COPY --from=builder /app/packages/shared-types/dist ./packages/shared-types/dist
COPY apps/backend/package.json ./apps/backend/
COPY --from=builder /app/apps/backend/dist ./apps/backend/dist
COPY apps/backend/prisma ./apps/backend/prisma

# Install production dependencies only
RUN npm ci --only=production

# Generate Prisma Client for runtime node_modules
RUN cd apps/backend && npx prisma generate

# Set ownership to non-root optix user
RUN chown -R optixuser:optixgroup /app

USER optixuser

EXPOSE 3000

# Health check probe
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000/health || exit 1

CMD ["node", "apps/backend/dist/server.js"]
