{
  "name": "optix-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Optix Enterprise Offline-First Android POS & Modular Business Operating System",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm --workspace=apps/backend run dev",
    "build:backend": "npm --workspace=apps/backend run build",
    "test:backend": "npm --workspace=apps/backend run test",
    "db:migrate": "npm --workspace=apps/backend run db:migrate",
    "db:seed": "npm --workspace=apps/backend run db:seed",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml down",
    "lint": "npm run lint:backend",
    "lint:backend": "npm --workspace=apps/backend run lint"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
