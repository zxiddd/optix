datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum BusinessType {
  RESTAURANT
  CHICKEN_SHOP
  BAKERY
  MEDICAL
  RETAIL
  SALON
}

enum PricingStrategy {
  FIXED
  WEIGHT
  VARIABLE
  MARKET
}

enum BillStatus {
  DRAFT
  FINALIZED
  VOIDED
  REFUNDED
}

enum UserRole {
  OWNER
  MANAGER
  SUPERVISOR
  CASHIER
  KITCHEN_STAFF
  DELIVERY
  ACCOUNTANT
}

enum PaymentMethod {
  CASH
  CARD_TENDER
  DIGITAL_UPI_QR
  STORE_CREDIT_KHATA
  LOYALTY_POINTS
}

model Business {
  id                String       @id @default(uuid()) @db.Uuid
  name              String       @db.VarChar(255)
  businessType      BusinessType @default(RETAIL) @map("business_type")
  currencyCode      String       @default("USD") @map("currency_code") @db.VarChar(3)
  currencySymbol    String       @default("$") @map("currency_symbol") @db.VarChar(5)
  decimalPrecision  Int          @default(2) @map("decimal_precision")
  timeZone          String       @default("UTC") @map("time_zone") @db.VarChar(50)
  isActive          Boolean      @default(true) @map("is_active")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  outlets           Outlet[]
  users             User[]
  devices           Device[]
  categories        Category[]
  products          Product[]
  customers         Customer[]
  bills             Bill[]

  @@map("businesses")
}

model Outlet {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  name        String   @db.VarChar(255)
  address     String?  @db.Text
  phone       String?  @db.VarChar(30)
  taxNumber   String?  @map("tax_number") @db.VarChar(50)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  devices     Device[]
  bills       Bill[]

  @@map("outlets")
}

model Device {
  id                 String   @id @default(uuid()) @db.Uuid
  businessId         String   @map("business_id") @db.Uuid
  outletId           String   @map("outlet_id") @db.Uuid
  deviceHardwareUuid String   @unique @map("device_hardware_uuid") @db.VarChar(128)
  deviceName         String   @map("device_name") @db.VarChar(100)
  appVersion         String   @map("app_version") @db.VarChar(20)
  lastSyncAt         DateTime? @map("last_sync_at") @db.Timestamptz
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outlet             Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@map("devices")
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  firebaseUid String?  @unique @map("firebase_uid") @db.VarChar(128)
  fullName    String   @map("full_name") @db.VarChar(150)
  role        UserRole @default(CASHIER)
  pinHash     String   @map("pin_hash") @db.VarChar(255)
  isArchived  Boolean  @default(false) @map("is_archived")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bills       Bill[]

  @@index([businessId, role])
  @@map("users")
}

model Category {
  id           String    @id @default(uuid()) @db.Uuid
  businessId   String    @map("business_id") @db.Uuid
  name         String    @db.VarChar(100)
  colorHex     String    @default("#4A90E2") @map("color_hex") @db.VarChar(7)
  displayOrder Int       @default(0) @map("display_order")
  isArchived   Boolean   @default(false) @map("is_archived")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products     Product[]

  @@map("categories")
}

model Product {
  id               String          @id @default(uuid()) @db.Uuid
  businessId       String          @map("business_id") @db.Uuid
  categoryId       String?         @map("category_id") @db.Uuid
  sku              String?         @db.VarChar(100)
  barcode          String?         @db.VarChar(100)
  title            String          @db.VarChar(255)
  pricingStrategy  PricingStrategy @default(FIXED) @map("pricing_strategy")
  unitPrice        Decimal         @default(0.0000) @map("unit_price") @db.Decimal(12, 4)
  costPrice        Decimal         @default(0.0000) @map("cost_price") @db.Decimal(12, 4)
  trackInventory   Boolean         @default(true) @map("track_inventory")
  currentStock     Decimal         @default(0.000) @map("current_stock") @db.Decimal(12, 3)
  reorderLevel     Decimal         @default(5.000) @map("reorder_level") @db.Decimal(12, 3)
  isArchived       Boolean         @default(false) @map("is_archived")
  versionTimestamp BigInt          @map("version_timestamp")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  business         Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category         Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  billItems        BillItem[]

  @@index([businessId, barcode])
  @@index([businessId, sku])
  @@index([businessId, versionTimestamp])
  @@map("products")
}

model Customer {
  id             String   @id @default(uuid()) @db.Uuid
  businessId     String   @map("business_id") @db.Uuid
  fullName       String   @map("full_name") @db.VarChar(150)
  phone          String   @db.VarChar(30)
  email          String?  @db.VarChar(150)
  creditLimit    Decimal  @default(0.0000) @map("credit_limit") @db.Decimal(12, 4)
  currentBalance Decimal  @default(0.0000) @map("current_balance") @db.Decimal(12, 4)
  loyaltyPoints  Int      @default(0) @map("loyalty_points")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bills          Bill[]

  @@index([businessId, phone])
  @@map("customers")
}

model Bill {
  id            String     @id @default(uuid()) @db.Uuid
  businessId    String     @map("business_id") @db.Uuid
  outletId      String     @map("outlet_id") @db.Uuid
  deviceId      String     @map("device_id") @db.VarChar(100)
  invoiceNumber String     @map("invoice_number") @db.VarChar(50)
  staffId       String     @map("staff_id") @db.Uuid
  customerId    String?    @map("customer_id") @db.Uuid
  subtotal      Decimal    @db.Decimal(12, 4)
  taxTotal      Decimal    @map("tax_total") @db.Decimal(12, 4)
  discountTotal Decimal    @default(0.0000) @map("discount_total") @db.Decimal(12, 4)
  grossTotal    Decimal    @map("gross_total") @db.Decimal(12, 4)
  status        BillStatus @default(FINALIZED)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz

  business      Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outlet        Outlet     @relation(fields: [outletId], references: [id], onDelete: Cascade)
  staff         User       @relation(fields: [staffId], references: [id])
  customer      Customer?  @relation(fields: [customerId], references: [id])
  items         BillItem[]
  payments      Payment[]

  @@unique([businessId, invoiceNumber])
  @@index([businessId, createdAt])
  @@map("bills")
}

model BillItem {
  id                  String   @id @default(uuid()) @db.Uuid
  billId              String   @map("bill_id") @db.Uuid
  productId           String?  @map("product_id") @db.Uuid
  productNameSnapshot String   @map("product_name_snapshot") @db.VarChar(255)
  skuSnapshot         String?  @map("sku_snapshot") @db.VarChar(100)
  unitPrice           Decimal  @map("unit_price") @db.Decimal(12, 4)
  quantity            Decimal  @db.Decimal(12, 3)
  lineTotal           Decimal  @map("line_total") @db.Decimal(12, 4)

  bill                Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  product             Product? @relation(fields: [productId], references: [id])

  @@map("bill_items")
}

model Payment {
  id                   String        @id @default(uuid()) @db.Uuid
  billId               String        @map("bill_id") @db.Uuid
  paymentMethod        PaymentMethod @map("payment_method")
  amount               Decimal       @db.Decimal(12, 4)
  transactionReference String?       @map("transaction_reference") @db.VarChar(100)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz

  bill                 Bill          @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@map("payments")
}
